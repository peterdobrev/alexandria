meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {"email": "peterdobrevxd@gmail.com", "password": "password"}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("authToken", res.body.token);
    bru.setEnvVar("userId", res.body.userId);
    expect(res.body.tokenType).to.equal("Bearer");
    expect(res.body.expiresIn).to.be.above(0);
  }
}
