meta {
  name: Add Comment to Document
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/documents/{{documentId}}/comments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

params:path {
  documentId: a1b2c3d4-e5f6-7890-abcd-ef1234567890
}

body:json {
{
  "body": "Great document! Really helped me understand the topic."
}
}

script:post-response {
  expect(res.status).to.equal(201);
  const location = res.headers["location"];
  if (location) {
    const parts = location.split("/");
    bru.setEnvVar("commentId", parts[parts.length - 1]);
  }
}
