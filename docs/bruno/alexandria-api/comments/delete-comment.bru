meta {
  name: Delete Comment
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/documents/{{documentId}}/comments/{{commentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

params:path {
  documentId: a1b2c3d4-e5f6-7890-abcd-ef1234567890
  commentId: b2c3d4e5-f6a7-8901-bcde-f12345678901
}
